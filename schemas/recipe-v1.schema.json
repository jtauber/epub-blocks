{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/jtauber/epub-blocks/main/schemas/recipe-v1.schema.json",
  "title": "epub-blocks extraction recipe version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["recipe_version", "blocks"],
  "properties": {
    "recipe_version": {"const": "1"},
    "epub": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "identifier": {"type": "string", "minLength": 1},
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "normalization": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "collapse_whitespace": {"type": "boolean", "default": true},
        "strip": {"type": "boolean", "default": true},
        "unicode_normalization": {
          "enum": ["NFC", "NFD", "NFKC", "NFKD", "none"],
          "default": "NFC"
        }
      }
    },
    "omit_epub_types": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1},
      "default": []
    },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/block"}
    }
  },
  "$defs": {
    "elementPath": {
      "type": "string",
      "pattern": "^(?:[1-9][0-9]*(?:\\.[1-9][0-9]*)*)?$"
    },
    "nonEmptyElementPath": {
      "type": "string",
      "pattern": "^[1-9][0-9]*(?:\\.[1-9][0-9]*)*$"
    },
    "slice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": {"type": "integer", "minimum": 0},
        "end": {"type": "integer", "minimum": 1}
      }
    },
    "part": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document"],
      "properties": {
        "document": {"type": "string", "minLength": 1},
        "element_path": {"$ref": "#/$defs/elementPath", "default": ""},
        "omit": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/nonEmptyElementPath"},
          "default": []
        },
        "slice": {"$ref": "#/$defs/slice"}
      }
    },
    "block": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "parts"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "type": {"type": "string", "minLength": 1},
        "separator": {"type": "string", "default": ""},
        "parts": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/part"}
        }
      }
    }
  }
}
