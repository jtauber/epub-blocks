{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/jtauber/epub-blocks/main/src/epub_blocks/schemas/recipe-v1.schema.json",
  "title": "epub-blocks extraction recipe version 1",
  "description": "A self-contained structural recipe that generates typed, identified text blocks from a pinned EPUB.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "recipe_version",
    "epub",
    "source_blocks",
    "output"
  ],
  "properties": {
    "recipe_version": {
      "const": "1"
    },
    "xml_repairs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["document", "offset", "expected", "replacement"],
        "properties": {
          "document": {"type": "string", "minLength": 1, "pattern": "^(?!.*(?:^|/)\\.{1,2}(?:/|$))[^/\\\\]+(?:/[^/\\\\]+)*$"},
          "offset": {"type": "integer", "minimum": 0},
          "expected": {"type": "string", "minLength": 1},
          "replacement": {"type": "string"}
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    },
    "epub": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha256"
      ],
      "properties": {
        "identifier": {
          "$ref": "#/$defs/nonEmptyString",
          "description": "Required at runtime if the EPUB package contains any nonempty dc:identifier. Omit only for identifier-less packages; null and empty strings are invalid."
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "normalization": {
      "type": "object",
      "additionalProperties": false,
      "default": {},
      "properties": {
        "collapse_whitespace": {
          "type": "boolean",
          "default": true
        },
        "strip": {
          "type": "boolean",
          "default": true
        },
        "unicode_normalization": {
          "enum": [
            "NFC",
            "NFD",
            "NFKC",
            "NFKD",
            "none"
          ],
          "default": "NFC"
        }
      }
    },
    "omit_epub_types": {
      "$ref": "#/$defs/stringArray"
    },
    "source_blocks": {
      "$ref": "#/$defs/sourceBlocks"
    },
    "output": {
      "$ref": "#/$defs/output"
    },
    "text": {
      "$ref": "#/$defs/text"
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "stringArray": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/nonEmptyString"
      },
      "default": []
    },
    "stringMap": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "minLength": 1
      },
      "additionalProperties": {
        "$ref": "#/$defs/nonEmptyString"
      }
    },
    "sourceLocator": {
      "type": "string",
      "pattern": "^.+#[1-9][0-9]*(?:\\.[1-9][0-9]*)*$",
      "not": {
        "pattern": "[\\r\\n\\u2028\\u2029]"
      }
    },
    "sourceLocatorArray": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/sourceLocator"
      },
      "default": []
    },
    "sourceBlocks": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "include_documents": {
          "$ref": "#/$defs/stringArray"
        },
        "exclude_documents": {
          "$ref": "#/$defs/stringArray"
        },
        "exclude_classes": {
          "$ref": "#/$defs/stringArray"
        },
        "include_locators": {
          "$ref": "#/$defs/stringArray"
        },
        "exclude_locators": {
          "$ref": "#/$defs/stringArray"
        },
        "include_non_linear": {
          "type": "boolean",
          "default": false
        },
        "element_rules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/elementRule"
          },
          "default": []
        },
        "strict_coverage": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "sourceMarker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pattern"
      ],
      "properties": {
        "pattern": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\^"
        },
        "case_insensitive": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "groups": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_pattern": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "source_marker": {
          "$ref": "#/$defs/sourceMarker"
        },
        "capture_kind": {
          "enum": [
            "string",
            "decimal",
            "roman"
          ],
          "default": "string"
        },
        "source_offset": {
          "type": "integer",
          "default": 0
        },
        "source_map": {
          "$ref": "#/$defs/stringMap"
        },
        "capture_width": {
          "type": "integer",
          "minimum": 1
        },
        "transitions": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "$ref": "#/$defs/sourceLocator"
          },
          "additionalProperties": {
            "$ref": "#/$defs/nonEmptyString"
          }
        }
      },
      "oneOf": [
        {
          "not": {
            "anyOf": [
              {
                "required": [
                  "source_pattern"
                ]
              },
              {
                "required": [
                  "source_marker"
                ]
              },
              {
                "required": [
                  "transitions"
                ]
              },
              {
                "required": [
                  "capture_kind"
                ]
              },
              {
                "required": [
                  "source_offset"
                ]
              },
              {
                "required": [
                  "source_map"
                ]
              },
              {
                "required": [
                  "capture_width"
                ]
              }
            ]
          }
        },
        {
          "required": [
            "source_pattern"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "source_marker"
                ]
              },
              {
                "required": [
                  "transitions"
                ]
              }
            ]
          }
        },
        {
          "required": [
            "source_marker"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "source_pattern"
                ]
              },
              {
                "required": [
                  "transitions"
                ]
              }
            ]
          }
        },
        {
          "required": [
            "transitions"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "source_pattern"
                ]
              },
              {
                "required": [
                  "source_marker"
                ]
              },
              {
                "required": [
                  "capture_kind"
                ]
              },
              {
                "required": [
                  "source_offset"
                ]
              },
              {
                "required": [
                  "source_map"
                ]
              },
              {
                "required": [
                  "capture_width"
                ]
              }
            ]
          }
        }
      ],
      "allOf": [
        {
          "if": {
            "required": [
              "source_map"
            ]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "capture_width"
                  ]
                },
                {
                  "properties": {
                    "source_offset": {
                      "not": {
                        "const": 0
                      }
                    }
                  },
                  "required": [
                    "source_offset"
                  ]
                }
              ]
            }
          }
        }
      ],
      "default": {}
    },
    "counter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "template"
      ],
      "properties": {
        "template": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "start": {
          "type": "integer",
          "minimum": 0,
          "default": 1
        }
      }
    },
    "identifiers": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "block"
      ],
      "properties": {
        "block": {
          "$ref": "#/$defs/counter"
        },
        "line": {
          "$ref": "#/$defs/counter"
        },
        "element_path_root": {
          "type": "string",
          "pattern": "^[1-9][0-9]*(\\.[1-9][0-9]*)*$(?![\\s\\S])",
          "description": "Since 0.8.0: fixed-ID element_path fields are relative to this body-relative container path. Every such first retained fragment must lie strictly below it. Source locators and literal IDs are unchanged."
        }
      }
    },
    "emission": {
      "description": "An output emission. Fixed id templates accept group and, since 0.8.0, element_path (the first retained source fragment's body-relative path). Templates are also validated by the runtime.",
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "role": {
          "enum": [
            "block",
            "line-start",
            "line",
            "fixed"
          ],
          "default": "block"
        },
        "id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "allow_empty": {
          "type": "boolean",
          "default": false
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "role": {
                "const": "fixed"
              }
            },
            "required": [
              "role"
            ]
          },
          "then": {
            "required": [
              "id"
            ]
          },
          "else": {
            "not": {
              "required": [
                "id"
              ]
            }
          }
        }
      ]
    },
    "defaultEmission": {
      "allOf": [
        {
          "$ref": "#/$defs/emission"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "role": {
              "enum": [
                "block",
                "line-start",
                "line",
                "fixed"
              ]
            },
            "id": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "allow_empty": {
              "type": "boolean",
              "default": false
            }
          }
        }
      ]
    },
    "match": {
      "type": "object",
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "tag"
          ]
        },
        {
          "required": [
            "classes"
          ]
        },
        {
          "required": [
            "text_pattern"
          ]
        },
        {
          "required": [
            "classes_any"
          ],
          "properties": {
            "classes_any": {
              "minItems": 1
            }
          }
        },
        {
          "required": [
            "classes_all"
          ],
          "properties": {
            "classes_all": {
              "minItems": 1
            }
          }
        },
        {
          "required": [
            "locators"
          ],
          "properties": {
            "locators": {
              "minItems": 1
            }
          }
        }
      ],
      "properties": {
        "tag": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "classes": {
          "$ref": "#/$defs/stringArray"
        },
        "classes_any": {
          "$ref": "#/$defs/stringArray"
        },
        "classes_all": {
          "$ref": "#/$defs/stringArray"
        },
        "locators": {
          "$ref": "#/$defs/stringArray"
        },
        "text_pattern": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "case_insensitive": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "removePrefix": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pattern"
      ],
      "properties": {
        "pattern": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\^"
        },
        "case_insensitive": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "rule": {
      "allOf": [
        {
          "if": {"required": ["consume_while"]},
          "then": {
            "not": {
              "anyOf": [
                {"required": ["consume"]},
                {"required": ["emit"]},
                {"required": ["remove_prefix"]}
              ]
            }
          }
        },
        {
          "$ref": "#/$defs/emission"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "match",
            "type"
          ],
          "properties": {
            "match": {
              "$ref": "#/$defs/match"
            },
            "type": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "role": {
              "enum": [
                "block",
                "line-start",
                "line",
                "fixed"
              ]
            },
            "id": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "consume": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            },
            "consume_while": {
              "$ref": "#/$defs/match"
            },
            "emit": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "integer",
                "minimum": 1
              }
            },
            "separator": {
              "type": "string"
            },
            "remove_prefix": {
              "$ref": "#/$defs/removePrefix"
            },
            "allow_empty": {
              "type": "boolean",
              "default": false
            }
          }
        }
      ]
    },
    "elementPath": {
      "type": "string",
      "pattern": "^(?:[1-9][0-9]*(?:\\.[1-9][0-9]*)*)?$"
    },
    "nonEmptyElementPath": {
      "type": "string",
      "pattern": "^[1-9][0-9]*(?:\\.[1-9][0-9]*)*$"
    },
    "slice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "part": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document"
      ],
      "properties": {
        "document": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "element_path": {
          "$ref": "#/$defs/elementPath"
        },
        "omit": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonEmptyElementPath"
          },
          "default": []
        },
        "slice": {
          "$ref": "#/$defs/slice"
        }
      }
    },
    "producedBlock": {
      "allOf": [
        {
          "$ref": "#/$defs/emission"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "parts"
          ],
          "properties": {
            "type": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "role": {
              "enum": [
                "block",
                "line-start",
                "line",
                "fixed"
              ]
            },
            "id": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "parts": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/part"
              }
            },
            "separator": {
              "type": "string",
              "default": ""
            },
            "allow_empty": {
              "type": "boolean",
              "default": false
            }
          }
        }
      ]
    },
    "replacement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "anchor",
        "outputs"
      ],
      "properties": {
        "anchor": {
          "$ref": "#/$defs/sourceLocator"
        },
        "outputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/producedBlock"
          }
        }
      }
    },
    "insertion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "after",
        "outputs"
      ],
      "properties": {
        "after": {
          "$ref": "#/$defs/sourceLocator"
        },
        "outputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/producedBlock"
          }
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identifiers",
        "default",
        "compiled_sha256"
      ],
      "properties": {
        "groups": {
          "$ref": "#/$defs/groups"
        },
        "identifiers": {
          "$ref": "#/$defs/identifiers"
        },
        "default": {
          "$ref": "#/$defs/defaultEmission"
        },
        "rules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/rule"
          },
          "default": []
        },
        "skip_source": {
          "$ref": "#/$defs/sourceLocatorArray"
        },
        "replacements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/replacement"
          },
          "default": []
        },
        "insertions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/insertion"
          },
          "default": []
        },
        "compiled_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "simpleSelector": {
      "type": "object",
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "tag"
          ]
        },
        {
          "required": [
            "classes"
          ]
        },
        {
          "required": [
            "empty"
          ]
        },
        {
          "required": [
            "classes_any"
          ],
          "properties": {
            "classes_any": {
              "minItems": 1
            }
          }
        },
        {
          "required": [
            "classes_all"
          ],
          "properties": {
            "classes_all": {
              "minItems": 1
            }
          }
        },
        {
          "required": [
            "locators"
          ],
          "properties": {
            "locators": {
              "minItems": 1
            }
          }
        },
        {
          "required": [
            "epub_types"
          ],
          "properties": {
            "epub_types": {
              "minItems": 1
            }
          }
        },
        {
          "required": [
            "attributes"
          ],
          "properties": {
            "attributes": {
              "minProperties": 1
            }
          }
        },
        {
          "required": ["attribute_prefixes"],
          "properties": {"attribute_prefixes": {"minProperties": 1}}
        }
      ],
      "properties": {
        "tag": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "classes": {
          "$ref": "#/$defs/stringArray"
        },
        "classes_any": {
          "$ref": "#/$defs/stringArray"
        },
        "classes_all": {
          "$ref": "#/$defs/stringArray"
        },
        "locators": {
          "$ref": "#/$defs/stringArray"
        },
        "epub_types": {
          "$ref": "#/$defs/stringArray"
        },
        "attributes": {
          "type": "object",
          "propertyNames": {
            "minLength": 1
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "attribute_prefixes": {
          "$ref": "#/$defs/attributePrefixes"
        },
        "empty": {
          "type": "boolean"
        }
      }
    },
    "attributePrefixes": {
      "type": "object",
      "propertyNames": {"minLength": 1},
      "additionalProperties": {"$ref": "#/$defs/nonEmptyString"}
    },
    "elementSelector": {
      "type": "object",
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "tag"
          ]
        },
        {
          "required": [
            "classes"
          ]
        },
        {
          "required": [
            "empty"
          ]
        },
        {
          "required": [
            "classes_any"
          ],
          "properties": {
            "classes_any": {
              "minItems": 1
            }
          }
        },
        {
          "required": [
            "classes_all"
          ],
          "properties": {
            "classes_all": {
              "minItems": 1
            }
          }
        },
        {
          "required": [
            "locators"
          ],
          "properties": {
            "locators": {
              "minItems": 1
            }
          }
        },
        {
          "required": [
            "epub_types"
          ],
          "properties": {
            "epub_types": {
              "minItems": 1
            }
          }
        },
        {
          "required": [
            "attributes"
          ],
          "properties": {
            "attributes": {
              "minProperties": 1
            }
          }
        },
        {
          "required": [
            "previous_sibling"
          ]
        },
        {
          "required": ["attribute_prefixes"],
          "properties": {"attribute_prefixes": {"minProperties": 1}}
        },
        {
          "required": [
            "has_child"
          ]
        }
      ],
      "properties": {
        "tag": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "classes": {
          "$ref": "#/$defs/stringArray"
        },
        "classes_any": {
          "$ref": "#/$defs/stringArray"
        },
        "classes_all": {
          "$ref": "#/$defs/stringArray"
        },
        "locators": {
          "$ref": "#/$defs/stringArray"
        },
        "epub_types": {
          "$ref": "#/$defs/stringArray"
        },
        "attributes": {
          "type": "object",
          "propertyNames": {
            "minLength": 1
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "empty": {
          "type": "boolean"
        },
        "previous_sibling": {
          "$ref": "#/$defs/simpleSelector"
        },
        "attribute_prefixes": {
          "$ref": "#/$defs/attributePrefixes"
        },
        "has_child": {
          "$ref": "#/$defs/simpleSelector"
        }
      }
    },
    "elementRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "match",
        "action"
      ],
      "properties": {
        "match": {
          "$ref": "#/$defs/elementSelector"
        },
        "action": {
          "enum": [
            "block",
            "descend",
            "skip"
          ]
        },
        "keep_empty": {
          "type": "boolean",
          "default": false
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "keep_empty"
            ]
          },
          "then": {
            "properties": {
              "action": {
                "const": "block"
              }
            }
          }
        }
      ]
    },
    "boundaryWhitespace": {
      "description": "Nonempty Python whitespace; explicit code points keep ECMA-262 and Python validators consistent.",
      "type": "string",
      "minLength": 1,
      "pattern": "^[\\u0009-\\u000D\\u001C-\\u0020\\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000]+$"
    },
    "boundaryRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["match"],
      "anyOf": [{"required": ["before"]}, {"required": ["after"]}],
      "properties": {
        "match": {"$ref": "#/$defs/elementSelector"},
        "before": {"$ref": "#/$defs/boundaryWhitespace"},
        "after": {"$ref": "#/$defs/boundaryWhitespace"}
      }
    },
    "markupRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "match",
        "kind",
        "name"
      ],
      "properties": {
        "match": {
          "$ref": "#/$defs/elementSelector"
        },
        "kind": {
          "enum": [
            "span",
            "milestone"
          ]
        },
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$"
        },
        "label_attribute": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "label_strip_prefix": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "label_text": {
          "type": "boolean",
          "default": false
        },
        "position": {
          "enum": ["replace", "before"],
          "default": "replace"
        },
        "label_counter": {
          "const": "ordered-list"
        },
        "continue_matching": {
          "type": "boolean",
          "default": false
        },
        "preserve_whitespace": {
          "type": "boolean",
          "default": false
        }
      },
      "allOf": [
        {
          "if": {"required": ["preserve_whitespace"]},
          "then": {"properties": {"kind": {"const": "span"}}}
        },
        {
          "if": {"required": ["label_strip_prefix"]},
          "then": {"required": ["label_attribute"]}
        },
        {
          "if": {
            "required": ["continue_matching"],
            "properties": {"continue_matching": {"const": true}}
          },
          "then": {
            "required": ["position"],
            "properties": {
              "kind": {"const": "milestone"},
              "position": {"const": "before"}
            }
          }
        },
        {
          "if": {"required": ["position"]},
          "then": {"properties": {"kind": {"const": "milestone"}}}
        },
        {
          "if": {"required": ["label_counter"]},
          "then": {
            "required": ["position"],
            "properties": {
              "kind": {"const": "milestone"},
              "position": {"const": "before"},
              "label_text": {"const": false}
            },
            "not": {"required": ["label_attribute"]}
          }
        },
        {
          "if": {
            "required": [
              "label_attribute"
            ]
          },
          "then": {
            "properties": {
              "kind": {
                "const": "milestone"
              }
            }
          }
        },
        {
          "if": {"required": ["label_text"]},
          "then": {"properties": {"kind": {"const": "milestone"}}}
        },
        {
          "if": {
            "required": ["label_text"],
            "properties": {"label_text": {"const": true}}
          },
          "then": {"not": {"required": ["label_attribute"]}}
        }
      ]
    },
    "markup": {
      "type": "object",
      "allOf": [
        {
          "if": {"required": ["format"], "properties": {"format": {"const": "literal"}}},
          "then": {
            "properties": {
              "delimiters": {"additionalProperties": {
                "items": {"not": {"pattern": "[\\t\\r\\n]"}},
                "contains": {"type": "string", "minLength": 1}
              }}
            }
          },
          "else": {
            "properties": {
              "delimiters": {"additionalProperties": {
                "uniqueItems": true,
                "items": {"minLength": 1, "not": {"pattern": "\\\\"}}
              }}
            }
          }
        },
        {
          "if": {
            "not": {"required": ["format"], "properties": {"format": {"const": "literal"}}},
            "required": ["rules"],
            "properties": {
              "rules": {
                "contains": {
                  "required": ["preserve_whitespace"],
                  "properties": {"preserve_whitespace": {"const": true}}
                }
              }
            }
          },
          "then": {
            "properties": {
              "delimiters": {
                "additionalProperties": {
                  "items": {"not": {"pattern": "[nrt\\t\\r\\n]"}}
                }
              }
            }
          }
        }
      ],
      "additionalProperties": false,
      "properties": {
        "attachment_order": {
          "enum": ["output", "source"],
          "default": "output"
        },
        "strip_outer_whitespace": {"type": "boolean", "default": false},
        "remove_source_newlines": {"type": "boolean", "default": false},
        "format": {
          "enum": [
            "xml",
            "delimiters",
            "literal"
          ],
          "default": "xml"
        },
        "rules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/markupRule"
          },
          "default": []
        },
        "delimiters": {
          "type": "object",
          "propertyNames": {
            "minLength": 1
          },
          "additionalProperties": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "string"
            }
          }
        },
        "between_blocks": {
          "enum": [
            "next",
            "error",
            "ignore"
          ],
          "default": "error"
        },
        "trailing": {
          "enum": [
            "previous",
            "error",
            "ignore"
          ],
          "default": "error"
        }
      }
    },
    "text": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "block_boundaries": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "tags": {
              "$ref": "#/$defs/stringArray"
            },
            "rules": {
              "type": "array",
              "items": {"$ref": "#/$defs/boundaryRule"},
              "default": []
            },
            "separator": {
              "$ref": "#/$defs/boundaryWhitespace",
              "default": " "
            }
          }
        },
        "markup": {
          "$ref": "#/$defs/markup"
        }
      }
    }
  }
}
